# OpenXgpro — Xgecu / MiniPro programmer USB permissions (TL866II / T48 / T56 / T76)
#
# Grant unprivileged users access to the programmer (VID 0xA466, PID 0x0A53),
# so the app can be run without root. Install as
#   /etc/udev/rules.d/99-openxgpro.rules
# then reload and replug:
#   sudo udevadm control --reload
#   sudo udevadm trigger

SUBSYSTEM=="usb", ATTR{idVendor}=="a466", ATTR{idProduct}=="0a53", MODE="0666", GROUP="plugdev"
